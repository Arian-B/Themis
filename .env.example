# =============================================================================
# Themis — Environment Variables
# Copy this file to .env and fill in all values before running docker compose.
# NEVER commit .env to version control.
# =============================================================================

# ── Neo4j ────────────────────────────────────────────────────────────────────
# Password for the Neo4j 'neo4j' user. Min 8 chars.
NEO4J_PASSWORD=changeme_strong_password

# ── LLM Providers ────────────────────────────────────────────────────────────
# Anthropic API key for Claude (risk analysis + negotiation simulation).
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# ── Langfuse (self-hosted) ────────────────────────────────────────────────────
# These are GENERATED by you when you first create a project in the Langfuse UI.
# Start Langfuse first (`docker compose up langfuse -d`), then create a project.
LANGFUSE_DB_PASSWORD=changeme_langfuse_db_password
LANGFUSE_NEXTAUTH_SECRET=changeme_32char_random_string_here
LANGFUSE_SALT=changeme_16char_salt
# Fill these AFTER creating a Langfuse project:
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...

# ── n8n ──────────────────────────────────────────────────────────────────────
N8N_USER=admin
N8N_PASSWORD=changeme_n8n_password

# ── FastAPI JWT ───────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=changeme_64char_hex_string

# ── Embedding model ───────────────────────────────────────────────────────────
# "ollama" for local dev (free), "openai" for production (higher quality)
EMBEDDING_PROVIDER=ollama
# Only needed if EMBEDDING_PROVIDER=openai:
# OPENAI_API_KEY=sk-...

# ── Ollama model selection ────────────────────────────────────────────────────
# Pull these after `docker compose up ollama -d`:
#   docker compose exec ollama ollama pull llama3.1:8b
#   docker compose exec ollama ollama pull nomic-embed-text
OLLAMA_CLASSIFY_MODEL=llama3.1:8b
OLLAMA_EMBED_MODEL=nomic-embed-text

# ── Application ──────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=DEBUG
