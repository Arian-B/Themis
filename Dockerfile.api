# =============================================================================
# Dockerfile.api — Themis FastAPI service
# Multi-stage: development (hot-reload) + production (gunicorn, minimal image)
# =============================================================================

# ── Base stage: shared dependencies ─────────────────────────────────────────
FROM python:3.12-slim AS base

WORKDIR /app

# System deps: pdfplumber requires poppler-utils; Presidio requires libgomp
RUN apt-get update && apt-get install -y --no-install-recommends \
    poppler-utils \
    libgomp1 \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies from pyproject.toml
COPY pyproject.toml ./
RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir ".[api]"

# ── Development stage: hot-reload with source bind mount ─────────────────────
FROM base AS development
# Source is bind-mounted at runtime (see docker-compose.yml volumes)
# No COPY needed — uvicorn --reload watches the mount
CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]

# ── Production stage: minimal image, no dev deps ─────────────────────────────
FROM base AS production
COPY . .
# Non-root user for security
RUN adduser --disabled-password --gecos "" themis \
    && chown -R themis:themis /app
USER themis
CMD ["gunicorn", "api.main:app", \
     "--workers", "4", \
     "--worker-class", "uvicorn.workers.UvicornWorker", \
     "--bind", "0.0.0.0:8000", \
     "--access-logfile", "-", \
     "--error-logfile", "-"]
